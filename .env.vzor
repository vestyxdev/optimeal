# OptiMeal – konfigurace frontendu
# Zkopírujte jako .env a doplňte hodnoty ze Supabase projektu
# (Project Settings → API). Do frontendu patří POUZE anon klíč –
# service-role klíč sem nikdy nepatří.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# Pro skript scripts/spust_migrace.mjs (volitelné, default je v souboru):
# SUPABASE_REF=<project-ref>
